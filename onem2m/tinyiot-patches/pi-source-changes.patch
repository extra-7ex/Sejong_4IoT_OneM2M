+/* SafeZone 패치 (2026-11-19): connect()에 시간 제한을 둔다.
+ * 구독 알림은 요청 응답 전에 같은 스레드에서 보낸다. 꺼진 구독 대상(ESP 등)에 연결하느라
+ * 같은 LAN이면 약 3초, 응답 없는 주소면 2분 넘게 막혀, 그동안 MQTT 요청 전체가 밀렸다. */
+static int connect_with_timeout(int sock, const struct sockaddr *addr, socklen_t len, int timeout_ms)
+{
+    int flags = fcntl(sock, F_GETFL, 0);
+    if (flags == -1 || fcntl(sock, F_SETFL, flags | O_NONBLOCK) == -1)
+        return connect(sock, addr, len);
+    int rc = connect(sock, addr, len);
+    if (rc == -1 && errno == EINPROGRESS)
+    {
+        struct pollfd pfd = {.fd = sock, .events = POLLOUT};
+        int pr;
+        do
+        {
+            pr = poll(&pfd, 1, timeout_ms);
+        } while (pr == -1 && errno == EINTR);
+        int soerr = 0;
+        socklen_t slen = sizeof(soerr);
+        if (pr == 1 && getsockopt(sock, SOL_SOCKET, SO_ERROR, &soerr, &slen) == 0 && soerr == 0)
+            rc = 0;
+        else
+        {
+            rc = -1;
+            logger("HTTP", LOG_LEVEL_ERROR, "connect %s (limit %d ms)", pr == 0 ? "timeout" : "failed", timeout_ms);
+        }
+    }
+    fcntl(sock, F_SETFL, flags);
+    return rc;
+}
