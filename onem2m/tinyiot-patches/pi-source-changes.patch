+/* TEXT 컬럼을 고정 버퍼 없이 cJSON에 추가 (buf[256] strncpy 스택 오버플로 수정) */
+static void db_add_text_column(cJSON *obj, const char *colname, sqlite3_stmt *stmt, int col)
+{
+    const char *txt = (const char *)sqlite3_column_text(stmt, col);
+    if (!txt)
+        return;
+
+    cJSON *parsed = cJSON_Parse(txt);
+    if (parsed && (cJSON_IsArray(parsed) || cJSON_IsObject(parsed)))
+    {
+        cJSON_AddItemToObject(obj, colname, parsed);
+    }
+    else
+    {
+        cJSON_Delete(parsed);
+        cJSON_AddItemToObject(obj, colname, cJSON_CreateString(txt));
+    }
+}
