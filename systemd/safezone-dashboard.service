[Unit]
Description=SafeZone 관제 대시보드 (port 8080)
After=network-online.target tinyiot-mn.service tinyiot-in-local.service
PartOf=safezone.target

[Service]
Type=simple
User=<PI_USER>
WorkingDirectory=/home/<PI_USER>/Sejong_4IoT_OneM2M
Environment=DASH_IN_BASE=http://127.0.0.1:3001/TinyIoT
EnvironmentFile=-/etc/default/safezone
ExecStart=/usr/bin/python3 -m dashboard.server --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=safezone.target
