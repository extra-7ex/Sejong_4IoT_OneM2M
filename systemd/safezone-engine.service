[Unit]
Description=SafeZone 위험 엔진 (engine.main)
After=network-online.target tinyiot-mn.service
PartOf=safezone.target

[Service]
Type=simple
User=<PI_USER>
WorkingDirectory=/home/<PI_USER>/Sejong_4IoT_OneM2M
# ACP 문제(#6) 때문에 지금은 CAdmin. --vision-path가 있으면 카메라·레이더 결합 규칙을 쓴다
Environment=ONEM2M_ORIGIN=CAdmin
Environment="ENGINE_ARGS=--transport polling --vision-path /AE-VisionAI/fusedTracks/la"
# 값을 바꾸려면 /etc/default/safezone에 같은 이름으로 적는다 (예: ENGINE_ARGS=--transport polling)
EnvironmentFile=-/etc/default/safezone
ExecStart=/usr/bin/python3 -m engine.main $ENGINE_ARGS
Restart=always
RestartSec=3

[Install]
WantedBy=safezone.target
