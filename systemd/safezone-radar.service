[Unit]
Description=SafeZone LD2450 레이더 업로더 (radar/radar_node.py)
After=network-online.target mosquitto.service tinyiot-mn.service
PartOf=safezone.target
# 가상 레이더와 같은 radar CNT에 쓰므로 둘 중 하나만 켠다
Conflicts=safezone-sim-radar.service

[Service]
Type=simple
# <PI_USER>, 저장소 경로는 systemd/install.sh가 바꿔 넣는다
User=<PI_USER>
WorkingDirectory=/home/<PI_USER>/Sejong_4IoT_OneM2M
Environment=PYTHONUNBUFFERED=1
Environment=RADAR_LOCAL_DECISION=0
EnvironmentFile=-/etc/default/safezone
ExecStart=/usr/bin/python3 radar/radar_node.py
Restart=always
RestartSec=3

[Install]
WantedBy=safezone.target
