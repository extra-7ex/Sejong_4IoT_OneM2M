[Unit]
Description=tinyIoT IN-CSE (on Pi, port 3001)
After=network-online.target

[Service]
Type=simple
# <PI_USER>, 경로는 실제 환경에 맞게 수정 (Pi 내부 IN 복사본)
User=<PI_USER>
WorkingDirectory=/home/<PI_USER>/tinyIoT-in/source/server
ExecStart=/home/<PI_USER>/tinyIoT-in/source/server/server
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
